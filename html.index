            <tr><td>Danh sách mua tự động</td><td class="compare-no">—</td><td class="compare-check">Có</td><td class="compare-check">Đồng bộ gia đình</td><td class="compare-check">Có</td></tr>
            <tr><td>Báo cáo tiến độ</td><td class="compare-no">—</td><td class="compare-check">Cá nhân</td><td class="compare-check">Gia đình</td><td class="compare-check">Chuyên sâu</td></tr>
            <tr><td>Quét ảnh tủ lạnh</td><td class="compare-no">—</td><td class="compare-check">Có</td><td class="compare-check">Có</td><td class="compare-check">Có</td></tr>
            <tr><td>AI điều chỉnh công thức</td><td class="compare-limited">Giới hạn</td><td class="compare-check">Có</td><td class="compare-check">Có</td><td class="compare-check">Theo macro</td></tr>
