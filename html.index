  free:{id:'free',name:'Free',audiences:['personal','family'],monthly:0,yearly:0,icon:'sprout',tagline:'Trải nghiệm giá trị cốt lõi của ReMeal.',description:'Phù hợp để bắt đầu quản lý nguyên liệu và nhận gợi ý món cơ bản.',features:['3 gợi ý công thức mỗi ngày','Tối đa 20 nguyên liệu','Kế hoạch tối đa 3 ngày','1 hồ sơ người dùng','10 công thức yêu thích'],missing:['Kế hoạch tuần tự động','Dinh dưỡng và báo cáo nâng cao']},
