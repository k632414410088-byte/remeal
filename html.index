<div class="modal" id="recipeModal"><div class="modal-card"><div class="modal-head"><h3>Chi tiết công thức</h3><button class="close-btn" data-close="recipeModal">×</button></div><div class="modal-body" id="recipeModalBody"></div></div></div>
<div class="modal" id="pantryModal"><div class="modal-card" style="width:min(620px,100%)"><div class="modal-head"><h3>Thêm nguyên liệu vào tủ</h3><button class="close-btn" data-close="pantryModal">×</button></div><div class="modal-body"><form id="pantryForm" class="form-grid"><div class="field full"><label>Tên nguyên liệu</label><input name="name" required placeholder="Ví dụ: Cà chua"></div><div class="field"><label>Số lượng</label><input name="qty" type="number" min="0" step="0.1" value="1" required></div><div class="field"><label>Đơn vị</label><select name="unit"><option>g</option><option>kg</option><option>quả</option><option>củ</option><option>bó</option><option>hộp</option><option>phần</option></select></div><div class="field"><label>Hạn sử dụng</label><input name="expiry" type="date" required></div><div class="field"><label>Trạng thái</label><select name="condition"><option value="fresh">Tươi</option><option value="cooked">Đã nấu chín</option><option value="frozen">Đông lạnh</option></select></div><div class="field"><label>Nhóm nguyên liệu</label><select name="category"><option value="protein">Chất đạm</option><option value="vegetable">Rau củ</option><option value="grain">Tinh bột</option><option value="other">Khác</option></select></div><div class="field"><label>Biểu tượng</label><input name="emoji" value="🥣"></div><div class="field full"><button class="primary-btn" type="submit">Thêm vào tủ lạnh</button></div></form></div></div></div>
<div class="modal" id="familyModal"><div class="modal-card" style="width:min(620px,100%)"><div class="modal-head"><h3>Thêm thành viên gia đình</h3><button class="close-btn" data-close="familyModal">×</button></div><div class="modal-body"><form id="familyForm" class="form-grid"><div class="field"><label>Tên</label><input name="name" required placeholder="Ví dụ: Minh"></div><div class="field"><label>Vai trò</label><input name="role" placeholder="Ví dụ: Con trai"></div><div class="field"><label>Biểu tượng</label><input name="avatar" value="🙂"></div><div class="field"><label>Mục tiêu</label><select name="goal"><option value="balanced">Ăn cân bằng</option><option value="weightloss">Giảm cân</option><option value="protein">Tăng protein</option><option value="fiber">Tăng chất xơ</option></select></div><div class="field full"><label>Giới hạn, ngăn cách bằng dấu phẩy</label><input name="restrictions" placeholder="Ví dụ: Không cay, Dị ứng hạt"></div><div class="field full"><label>Ghi chú khẩu vị</label><textarea name="note" placeholder="Ví dụ: thích món mềm, không thích nấm"></textarea></div><div class="field full"><button class="primary-btn" type="submit">Lưu thành viên</button></div></form></div></div></div>

<div class="modal" id="upgradeLockModal"><div class="modal-card" style="width:min(640px,100%)"><div class="modal-head"><h3>Tính năng dành cho gói trả phí</h3><button class="close-btn" data-close="upgradeLockModal">×</button></div><div class="modal-body"><div class="upgrade-lock-content"><div class="upgrade-lock-icon"><i data-lucide="lock-keyhole"></i></div><h2 id="lockedFeatureTitle">Mở khóa tính năng này</h2><p id="lockedFeatureDescription">Nâng cấp để sử dụng tính năng nâng cao của ReMeal.</p><div class="upgrade-lock-benefits" id="lockedFeatureBenefits"></div><button class="primary-btn" id="lockedFeatureUpgradeBtn"><i data-lucide="crown" width="16"></i> Xem gói được đề xuất</button><button class="secondary-btn" data-close="upgradeLockModal" style="margin-left:7px">Để sau</button></div></div></div></div>
<div class="modal" id="checkoutModal"><div class="modal-card checkout-card"><div class="modal-head"><h3>Nâng cấp ReMeal</h3><button class="close-btn" data-close="checkoutModal">×</button></div><div class="modal-body"><div class="checkout-layout"><div class="checkout-summary" id="checkoutSummary"></div><form class="checkout-form" id="checkoutForm"><div><h3>Thông tin thanh toán</h3><p style="font-size:9px;color:var(--muted);margin-top:4px">Chỉ là mô phỏng giao diện, không thu tiền thật.</p></div><div class="field"><label>Họ và tên</label><input required value="Lan Anh"></div><div class="field"><label>Email nhận hóa đơn</label><input type="email" required value="lananh@example.com"></div><div class="field"><label>Phương thức thanh toán</label><div class="payment-methods" id="paymentMethods"><button type="button" class="payment-method active">💳 Thẻ</button><button type="button" class="payment-method">🏦 Chuyển khoản</button><button type="button" class="payment-method">📱 Ví điện tử</button></div></div><div class="checkout-disclaimer">Bằng cách xác nhận, bạn đồng ý mô phỏng nâng cấp gói trong trình duyệt. Có thể khôi phục về Free trong Trung tâm tài khoản.</div><button class="primary-btn" type="submit" style="width:100%;min-height:50px" id="checkoutConfirmBtn">Xác nhận nâng cấp</button></form></div></div></div></div>

<div class="toast" id="toast"><i data-lucide="check-circle-2" width="18"></i><span id="toastText">Đã cập nhật.</span></div>

<div class="music-widget" id="musicWidget">
  <button class="music-fab" id="musicFabBtn" aria-label="Mở playlist nhạc"><i data-lucide="music-4"></i></button>
  <div class="music-panel" id="musicPanel">
    <div class="music-panel-head">
      <strong><i data-lucide="disc-3"></i> Playlist Cho Bạn</strong>
      <button class="music-close" id="musicCloseBtn" aria-label="Đóng"><i data-lucide="x"></i></button>
    </div>
    <div class="music-tabs" id="musicTabs">
      <button class="music-tab active" data-genre="vpop">🇻🇳 Việt</button>
      <button class="music-tab" data-genre="kpop">🇰🇷 Hàn</button>
      <button class="music-tab" data-genre="cpop">🇨🇳 Trung</button>
      <button class="music-tab" data-genre="lofi">🎧 Lofi</button>
    </div>
    <div class="music-frame-wrap">
      <iframe id="musicFrame" src="" title="Trình phát nhạc" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen loading="lazy"></iframe>
    </div>
    <p class="music-hint">🎵 Nhạc phát qua YouTube — bấm ▶ trong khung để nghe.</p>
  </div>
</div>

<script>
const $=(s,p=document)=>p.querySelector(s),$$=(s,p=document)=>[...p.querySelectorAll(s)];const currency=v=>new Intl.NumberFormat("vi-VN").format(Math.round(v))+"đ";const todayIso=()=>new Date().toISOString().slice(0,10);const addDays=d=>{const x=new Date();x.setDate(x.getDate()+d);return x.toISOString().slice(0,10)};
const catalog={chicken:{name:"Thịt gà",emoji:"🍗",category:"protein",price:65000},egg:{name:"Trứng gà",emoji:"🥚",category:"protein",price:4000},carrot:{name:"Cà rốt",emoji:"🥕",category:"vegetable",price:5000},greens:{name:"Rau cải xanh",emoji:"🥬",category:"vegetable",price:12000},rice:{name:"Cơm",emoji:"🍚",category:"grain",price:7000},mushroom:{name:"Nấm rơm",emoji:"🍄",category:"vegetable",price:18000},tofu:{name:"Đậu hũ",emoji:"🧈",category:"protein",price:8000},tomato:{name:"Cà chua",emoji:"🍅",category:"vegetable",price:6000},beef:{name:"Thịt bò",emoji:"🥩",category:"protein",price:95000},potato:{name:"Khoai tây",emoji:"🥔",category:"vegetable",price:7000},onion:{name:"Hành tây",emoji:"🧅",category:"vegetable",price:6000},scallion:{name:"Hành lá",emoji:"🌿",category:"vegetable",price:5000},garlic:{name:"Tỏi",emoji:"🧄",category:"other",price:3000},pumpkin:{name:"Bí đỏ",emoji:"🎃",category:"vegetable",price:12000},bread:{name:"Bánh mì",emoji:"🍞",category:"grain",price:6000},noodles:{name:"Mì",emoji:"🍜",category:"grain",price:10000},milk:{name:"Sữa",emoji:"🥛",category:"other",price:28000},yogurt:{name:"Sữa chua",emoji:"🥣",category:"other",price:8000},cucumber:{name:"Dưa chuột",emoji:"🥒",category:"vegetable",price:7000}};
const defaultPantry=()=>[{id:crypto.randomUUID(),key:"chicken",name:"Thịt gà",emoji:"🍗",qty:350,unit:"g",expiry:addDays(1),condition:"fresh",category:"protein"},{id:crypto.randomUUID(),key:"egg",name:"Trứng gà",emoji:"🥚",qty:6,unit:"quả",expiry:addDays(8),condition:"fresh",category:"protein"},{id:crypto.randomUUID(),key:"carrot",name:"Cà rốt",emoji:"🥕",qty:2,unit:"củ",expiry:addDays(2),condition:"fresh",category:"vegetable"},{id:crypto.randomUUID(),key:"greens",name:"Rau cải xanh",emoji:"🥬",qty:1,unit:"bó",expiry:addDays(3),condition:"fresh",category:"vegetable"},{id:crypto.randomUUID(),key:"rice",name:"Cơm nguội",emoji:"🍚",qty:2,unit:"chén",expiry:addDays(1),condition:"cooked",category:"grain"},{id:crypto.randomUUID(),key:"mushroom",name:"Nấm rơm",emoji:"🍄",qty:150,unit:"g",expiry:addDays(2),condition:"fresh",category:"vegetable"},{id:crypto.randomUUID(),key:"tofu",name:"Đậu hũ",emoji:"🧈",qty:1,unit:"miếng",expiry:addDays(4),condition:"frozen",category:"protein"},{id:crypto.randomUUID(),key:"garlic",name:"Tỏi",emoji:"🧄",qty:5,unit:"tép",expiry:addDays(14),condition:"fresh",category:"other"}];
const defaultMembers=()=>[{id:crypto.randomUUID(),name:"Lan Anh",role:"Bạn",avatar:"👩🏻",goal:"balanced",restrictions:["Không ăn cay"],note:"Ưu tiên món nhiều rau",selected:true},{id:crypto.randomUUID(),name:"Minh",role:"Chồng",avatar:"👨🏻",goal:"protein",restrictions:[],note:"Đang tập gym",selected:true},{id:crypto.randomUUID(),name:"Bé An",role:"Con",avatar:"👧🏻",goal:"balanced",restrictions:["Dị ứng hạt"],note:"Thích món mềm, ít gia vị",selected:false}];
const R=(id,title,image,desc,mealTypes,servings,time,difficulty,equipment,diet,allergens,ingredients,nutrition,steps)=>({id,title,image,desc,mealTypes,servings,time,difficulty,equipment,diet,allergens,spicy:false,ingredients,nutrition,steps});
const recipes=[R("fried-rice-chicken","Cơm chiên gà rau củ","https://images.unsplash.com/photo-1603133872878-684f208fb84b?auto=format&fit=crop&w=900&q=86","Tận dụng cơm nguội, thịt gà và rau củ thành bữa ăn đủ chất, dễ nấu.",["lunch","dinner"],2,25,"easy",["stove","pan"],["dairyfree"],[],[{key:"rice",amount:300,unit:"g",role:"main",required:true},{key:"chicken",amount:180,unit:"g",role:"main",required:true,substitutes:["tofu"]},{key:"egg",amount:2,unit:"quả",role:"secondary",required:false},{key:"carrot",amount:1,unit:"củ",role:"secondary",required:false},{key:"greens",amount:.5,unit:"bó",role:"secondary",required:false},{key:"scallion",amount:.5,unit:"bó",role:"seasoning",required:false}],{calories:520,protein:36,carbs:62,fat:14,fiber:7},["Cắt nhỏ thịt gà và rau củ.","Áp chảo thịt gà đến khi vừa chín.","Cho trứng và cơm nguội vào đảo đều.","Thêm rau củ, nêm gia vị và xào thêm 3–4 phút."]),R("egg-greens","Trứng xào rau cải","https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=900&q=86","Món nhanh cho ngày bận rộn, giàu đạm từ trứng và chất xơ từ rau.",["breakfast","lunch","dinner"],2,15,"easy",["stove","pan"],["vegetarian","dairyfree","glutenfree"],[],[{key:"egg",amount:3,unit:"quả",role:"main",required:true},{key:"greens",amount:1,unit:"bó",role:"main",required:true},{key:"carrot",amount:.5,unit:"củ",role:"secondary",required:false},{key:"garlic",amount:1,unit:"tép",role:"seasoning",required:false}],{calories:270,protein:21,carbs:13,fat:15,fiber:5},["Rửa sạch và cắt rau vừa ăn.","Đánh đều trứng với một ít gia vị.","Xào rau nhanh trên lửa lớn.","Cho trứng vào, đảo đến khi vừa chín mềm."]),R("chicken-mushroom-soup","Canh gà nấm rau xanh","https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=900&q=86","Canh thanh nhẹ, nhiều rau và protein nạc, phù hợp bữa tối ít dầu mỡ.",["lunch","dinner"],2,30,"easy",["stove","pot"],["dairyfree","glutenfree"],[],[{key:"chicken",amount:220,unit:"g",role:"main",required:true,substitutes:["tofu"]},{key:"mushroom",amount:100,unit:"g",role:"main",required:true},{key:"greens",amount:.5,unit:"bó",role:"secondary",required:false},{key:"carrot",amount:1,unit:"củ",role:"secondary",required:false}],{calories:330,protein:39,carbs:22,fat:9,fiber:8},["Sơ chế gà, nấm và rau củ.","Đun nước, cho thịt gà vào nấu chín.","Thêm cà rốt và nấm, nấu 8 phút.","Cho rau cải vào cuối cùng, nêm vừa ăn rồi tắt bếp."]),R("tofu-tomato","Đậu hũ sốt cà chua","https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=900&q=86","Món chay dễ ăn, chi phí thấp, có thể dùng cùng cơm hoặc rau luộc.",["lunch","dinner"],2,22,"easy",["stove","pan"],["vegetarian","dairyfree","glutenfree"],[],[{key:"tofu",amount:2,unit:"miếng",role:"main",required:true},{key:"tomato",amount:3,unit:"quả",role:"main",required:true},{key:"scallion",amount:.5,unit:"bó",role:"seasoning",required:false},{key:"garlic",amount:1,unit:"tép",role:"seasoning",required:false}],{calories:310,protein:22,carbs:24,fat:16,fiber:7},["Cắt đậu hũ thành miếng vừa ăn.","Áp chảo đậu hũ đến khi vàng nhẹ.","Nấu cà chua thành sốt sệt.","Cho đậu hũ vào rim 5 phút rồi thêm hành lá."]),R("chicken-egg-salad","Salad gà trứng","https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&fit=crop&w=900&q=86","Bữa ăn nhiều protein, nhiều rau và dễ điều chỉnh cho mục tiêu giảm cân.",["lunch","dinner"],2,20,"easy",["stove","pot"],["glutenfree"],["dairy"],[{key:"chicken",amount:180,unit:"g",role:"main",required:true},{key:"egg",amount:2,unit:"quả",role:"secondary",required:false},{key:"greens",amount:1,unit:"bó",role:"main",required:true},{key:"carrot",amount:1,unit:"củ",role:"secondary",required:false},{key:"cucumber",amount:1,unit:"quả",role:"secondary",required:false},{key:"yogurt",amount:1,unit:"hộp",role:"seasoning",required:false}],{calories:360,protein:43,carbs:19,fat:13,fiber:8},["Luộc hoặc áp chảo thịt gà.","Luộc trứng và cắt đôi.","Rửa rau, thái cà rốt và dưa chuột.","Trộn tất cả với sốt sữa chua hoặc dầu giấm."]),R("chicken-congee","Cháo gà nấm","https://images.unsplash.com/photo-1625944525533-473f1a3d54e7?auto=format&fit=crop&w=900&q=86","Món mềm, dễ ăn, phù hợp trẻ em hoặc khi cần bữa nhẹ bụng.",["breakfast","dinner"],3,42,"medium",["stove","pot"],["dairyfree","glutenfree"],[],[{key:"rice",amount:180,unit:"g",role:"main",required:true},{key:"chicken",amount:220,unit:"g",role:"main",required:true},{key:"mushroom",amount:100,unit:"g",role:"secondary",required:false},{key:"carrot",amount:.5,unit:"củ",role:"secondary",required:false},{key:"scallion",amount:.5,unit:"bó",role:"seasoning",required:false}],{calories:390,protein:31,carbs:55,fat:7,fiber:5},["Vo gạo và nấu với nhiều nước.","Luộc gà, xé nhỏ và giữ lại nước dùng.","Cho nấm, cà rốt và gà vào cháo.","Nấu đến khi mềm, nêm nhẹ và thêm hành."]),R("beef-noodles","Mì xào bò rau củ","https://images.unsplash.com/photo-1585032226651-759b368d7246?auto=format&fit=crop&w=900&q=86","Món no lâu, giàu protein, phù hợp bữa trưa hoặc tối cần nhiều năng lượng.",["lunch","dinner"],2,28,"medium",["stove","pan"],["dairyfree"],["gluten"],[{key:"beef",amount:200,unit:"g",role:"main",required:true},{key:"noodles",amount:250,unit:"g",role:"main",required:true},{key:"carrot",amount:1,unit:"củ",role:"secondary",required:false},{key:"greens",amount:.5,unit:"bó",role:"secondary",required:false},{key:"onion",amount:.5,unit:"củ",role:"secondary",required:false}],{calories:610,protein:39,carbs:77,fat:17,fiber:7},["Luộc mì vừa chín rồi để ráo.","Ướp bò nhẹ và xào nhanh trên lửa lớn.","Xào rau củ, cho mì vào đảo đều.","Thêm bò trở lại, nêm vừa ăn."]),R("pumpkin-soup","Súp bí đỏ","https://images.unsplash.com/photo-1547592166-23ac45744acd?auto=format&fit=crop&w=900&q=86","Súp ấm, nhiều chất xơ, phù hợp bữa sáng hoặc bữa tối nhẹ.",["breakfast","dinner"],2,35,"easy",["stove","pot"],["vegetarian","glutenfree"],["dairy"],[{key:"pumpkin",amount:350,unit:"g",role:"main",required:true},{key:"milk",amount:200,unit:"ml",role:"secondary",required:false},{key:"onion",amount:.5,unit:"củ",role:"secondary",required:false}],{calories:260,protein:8,carbs:42,fat:9,fiber:9},["Cắt bí đỏ và hành tây.","Nấu mềm bí với một ít nước.","Xay hoặc nghiền nhuyễn.","Thêm sữa, nêm nhẹ và đun thêm 3 phút."]),R("tofu-rice-bowl","Cơm bowl đậu hũ rau củ","https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=900&q=86","Bowl chay cân bằng, nhiều màu sắc, dễ thay đổi theo rau đang có.",["lunch","dinner"],2,25,"easy",["stove","pan"],["vegetarian","dairyfree","glutenfree"],["soy"],[{key:"rice",amount:300,unit:"g",role:"main",required:true},{key:"tofu",amount:2,unit:"miếng",role:"main",required:true},{key:"carrot",amount:1,unit:"củ",role:"secondary",required:false},{key:"greens",amount:.5,unit:"bó",role:"secondary",required:false},{key:"mushroom",amount:100,unit:"g",role:"secondary",required:false}],{calories:500,protein:26,carbs:68,fat:15,fiber:11},["Áp chảo đậu hũ đến khi vàng.","Xào nhanh nấm và rau củ.","Cho cơm vào tô.","Xếp đậu hũ, rau lên trên và thêm sốt tùy chọn."]),R("potato-egg","Khoai tây trứng áp chảo","https://images.unsplash.com/photo-1510693206972-df098062cb71?auto=format&fit=crop&w=900&q=86","Món ít nguyên liệu, no lâu, phù hợp bữa sáng hoặc bữa nhẹ.",["breakfast","lunch"],2,24,"easy",["stove","pan"],["vegetarian","dairyfree","glutenfree"],[],[{key:"potato",amount:3,unit:"củ",role:"main",required:true},{key:"egg",amount:3,unit:"quả",role:"main",required:true},{key:"onion",amount:.5,unit:"củ",role:"secondary",required:false}],{calories:440,protein:20,carbs:54,fat:17,fiber:6},["Thái khoai tây lát mỏng.","Áp chảo khoai đến khi mềm và vàng.","Đổ trứng đánh lên trên.","Đậy nắp đến khi trứng chín."]),R("chicken-sandwich","Sandwich gà rau xanh","https://images.unsplash.com/photo-1553909489-cd47e0907980?auto=format&fit=crop&w=900&q=86","Tận dụng gà đã nấu thành bữa sáng hoặc trưa mang đi.",["breakfast","lunch","snack"],2,12,"easy",["pan"],["dairyfree"],["gluten"],[{key:"bread",amount:4,unit:"lát",role:"main",required:true},{key:"chicken",amount:150,unit:"g",role:"main",required:true},{key:"greens",amount:.5,unit:"bó",role:"secondary",required:false},{key:"tomato",amount:1,unit:"quả",role:"secondary",required:false}],{calories:420,protein:35,carbs:49,fat:10,fiber:6},["Xé nhỏ thịt gà đã nấu.","Rửa và để ráo rau.","Xếp gà, rau và cà chua vào bánh mì.","Áp chảo nhẹ hai mặt nếu muốn ăn nóng."]),R("vegetable-stirfry","Rau củ nấm áp chảo","https://images.unsplash.com/photo-1543353071-087092ec393a?auto=format&fit=crop&w=900&q=86","Món phụ nhiều rau, ít năng lượng, dùng tốt cho mục tiêu giảm cân.",["lunch","dinner"],2,18,"easy",["stove","pan"],["vegetarian","dairyfree","glutenfree"],[],[{key:"mushroom",amount:150,unit:"g",role:"main",required:true},{key:"carrot",amount:1,unit:"củ",role:"secondary",required:false},{key:"greens",amount:1,unit:"bó",role:"main",required:true},{key:"garlic",amount:1,unit:"tép",role:"seasoning",required:false}],{calories:180,protein:9,carbs:25,fat:6,fiber:10},["Rửa sạch và cắt rau củ.","Làm nóng chảo với lượng dầu nhỏ.","Cho nấm và cà rốt vào trước.","Thêm rau xanh, nêm nhẹ và đảo nhanh."])];
const leftoverMap={rice:["Cơm chiên rau củ|Thêm trứng và rau còn lại, hoàn thành trong khoảng 15 phút.","Cháo nhanh|Nấu cơm nguội với nước dùng, thêm nấm hoặc thịt xé.","Cơm nắm áp chảo|Trộn cơm với rau băm, tạo viên và áp chảo hai mặt."],chicken:["Salad gà|Xé gà, trộn rau xanh và sốt nhẹ.","Sandwich gà|Kẹp gà cùng cà chua và rau để làm bữa sáng.","Cháo gà|Tận dụng gà và nước dùng cho bữa nhẹ bụng."],vegetables:["Trứng cuộn rau|Băm rau đã chín và cuộn cùng trứng.","Súp rau củ|Xay rau với nước dùng để tạo món súp nhanh.","Mì xào rau|Cho rau vào cuối cùng để tránh bị quá mềm."],bread:["Bánh mì trứng nướng|Nhúng bánh vào trứng và áp chảo.","Crouton giòn|Cắt nhỏ, nướng hoặc áp chảo làm topping salad.","Pudding bánh mì|Trộn bánh với sữa, trứng rồi nướng."],broth:["Súp nấm|Thêm nấm, rau và đậu hũ vào nước dùng.","Cháo rau củ|Nấu cơm hoặc gạo cùng nước dùng còn thừa.","Mì nước nhanh|Thêm mì, trứng và rau để có bữa 15 phút."]};
const defaultHistory=()=>[{id:crypto.randomUUID(),recipeId:"fried-rice-chicken",date:addDays(-1),saved:35000,rescued:.6},{id:crypto.randomUUID(),recipeId:"egg-greens",date:addDays(-2),saved:26000,rescued:.3},{id:crypto.randomUUID(),recipeId:"chicken-mushroom-soup",date:addDays(-4),saved:42000,rescued:.7}];
const state={pantry:JSON.parse(localStorage.getItem("remeal_pantry")||"null")||defaultPantry(),members:JSON.parse(localStorage.getItem("remeal_members")||"null")||defaultMembers(),planner:JSON.parse(localStorage.getItem("remeal_planner")||"{}"),shopping:JSON.parse(localStorage.getItem("remeal_shopping")||"[]"),history:JSON.parse(localStorage.getItem("remeal_history")||"null")||defaultHistory(),builder:{selectedPantry:[],mealType:"dinner",servings:2,maxTime:30,difficulty:"easy",equipment:["stove","pan","pot"],budget:50000,goal:"balanced",restrictions:["nospicy"]},results:[]};
function save(){localStorage.setItem("remeal_pantry",JSON.stringify(state.pantry));localStorage.setItem("remeal_members",JSON.stringify(state.members));localStorage.setItem("remeal_planner",JSON.stringify(state.planner));localStorage.setItem("remeal_shopping",JSON.stringify(state.shopping));localStorage.setItem("remeal_history",JSON.stringify(state.history))}function daysUntil(d){return Math.ceil((new Date(d+"T00:00:00")-new Date(todayIso()+"T00:00:00"))/86400000)}function pStatus(i){const d=daysUntil(i.expiry);if(i.condition==="frozen")return{key:"frozen",label:"Đông lạnh",cls:"blue"};if(i.condition==="cooked")return{key:"cooked",label:"Đã nấu chín",cls:"blue"};if(d<=1)return{key:"urgent",label:"Cần dùng ngay",cls:"red"};if(d<=3)return{key:"soon",label:"Sắp hết hạn",cls:"orange"};return{key:"fresh",label:"Còn tươi",cls:""}}function showToast(m){$("#toastText").textContent=m;$("#toast").classList.add("show");clearTimeout(window.__t);window.__t=setTimeout(()=>$("#toast").classList.remove("show"),2500)}function showView(n){$$('.view').forEach(v=>v.classList.remove('active'));$$('.nav-btn').forEach(b=>b.classList.toggle('active',b.dataset.view===n));const v=$("#"+n+"View");if(v)v.classList.add('active');$("#mainNav").classList.remove('show');scrollTo({top:0,behavior:'smooth'});({pantry:renderPantry,builder:renderBuilder,recipes:renderResults,planner:renderPlanner,shopping:renderShopping,family:renderFamily,progress:renderProgress}[n]||(()=>{}))()}
function renderHome(){const x=[...state.pantry].sort((a,b)=>daysUntil(a.expiry)-daysUntil(b.expiry)).slice(0,3);$("#homeRescueList").innerHTML=x.map(i=>`<div class="rescue-item"><div class="food-icon">${i.emoji}</div><div><strong>${i.name}</strong><small>${i.qty}${i.unit} · ${pStatus(i).label}</small></div><span class="days-left">${daysUntil(i.expiry)<=0?'Hôm nay':daysUntil(i.expiry)+' ngày'}</span></div>`).join('');const money=82000+state.history.reduce((s,h)=>s+h.saved,0),food=6.8+state.history.reduce((s,h)=>s+h.rescued,0);$("#homeMealCount").textContent=9+state.history.length;$("#homeSavedMoney").textContent=Math.round(money/1000)+'K';$("#homeRescued").textContent=food.toFixed(1)+'kg'}
function renderPantry(){const q=($("#pantrySearch")?.value||'').toLowerCase(),f=$("#pantryFilter")?.value||'all',c=$("#pantryCategory")?.value||'all';const list=state.pantry.filter(i=>i.name.toLowerCase().includes(q)&&(f==='all'||pStatus(i).key===f)&&(c==='all'||i.category===c));$("#pantryGrid").innerHTML=list.map(i=>{const s=pStatus(i),d=daysUntil(i.expiry),cls=s.key==='urgent'?'urgent':s.key==='soon'?'soon':'',w=i.condition==='frozen'?100:Math.max(8,Math.min(100,d/12*100));return`<article class="pantry-card"><div class="pantry-card-top"><div class="food-icon">${i.emoji}</div><div><h4>${i.name}</h4><p>${i.qty}${i.unit} · ${s.label}</p></div></div><div class="pantry-card-meta"><div class="meta-line"><span>Hạn sử dụng</span><strong>${i.expiry}</strong></div><div class="expiry-track ${cls}"><span style="width:${w}%"></span></div><div class="meta-line"><span>Còn lại</span><strong>${i.condition==='frozen'?'Đang đông lạnh':d<=0?'Dùng ngay':d+' ngày'}</strong></div></div><div class="pantry-card-actions"><button class="icon-btn" onclick="adjustPantry('${i.id}',-1)"><i data-lucide="minus"></i></button><button class="icon-btn" onclick="adjustPantry('${i.id}',1)"><i data-lucide="plus"></i></button><button class="icon-btn" onclick="usePantry('${i.id}')"><i data-lucide="check"></i></button><button class="icon-btn" onclick="removePantry('${i.id}')"><i data-lucide="trash-2"></i></button></div></article>`}).join('')||`<div class="health-notice" style="grid-column:1/-1">Không tìm thấy nguyên liệu phù hợp bộ lọc.</div>`;const counts={urgent:0,soon:0,fresh:0,cooked:0,frozen:0};state.pantry.forEach(i=>counts[pStatus(i).key]++);$("#pantryCountPill").textContent=state.pantry.length+' mục';$("#pantryStatusList").innerHTML=`<div class="status-row"><span>Cần dùng ngay</span><strong>${counts.urgent}</strong></div><div class="status-row"><span>Sắp hết hạn</span><strong>${counts.soon}</strong></div><div class="status-row"><span>Còn tươi</span><strong>${counts.fresh}</strong></div><div class="status-row"><span>Đã nấu chín</span><strong>${counts.cooked}</strong></div><div class="status-row"><span>Đông lạnh</span><strong>${counts.frozen}</strong></div>`;renderHome();lucide.createIcons()}window.adjustPantry=(id,d)=>{const i=state.pantry.find(x=>x.id===id);if(!i)return;i.qty=Math.max(0,+i.qty+d);if(i.qty<=0)state.pantry=state.pantry.filter(x=>x.id!==id);save();renderPantry();renderBuilder()};window.usePantry=id=>{const i=state.pantry.find(x=>x.id===id);if(!i)return;i.qty=Math.max(0,+i.qty-1);if(i.qty<=0)state.pantry=state.pantry.filter(x=>x.id!==id);save();renderPantry();renderBuilder();showToast('Đã cập nhật lượng nguyên liệu còn lại.')};window.removePantry=id=>{state.pantry=state.pantry.filter(x=>x.id!==id);save();renderPantry();renderBuilder();showToast('Đã xóa nguyên liệu khỏi tủ.')};function renderLeftovers(){const k=$("#leftoverSelect").value;$("#leftoverResult").innerHTML=leftoverMap[k].map(s=>{const[a,b]=s.split('|');return`<div class="leftover-suggestion"><strong>${a}</strong>${b}</div>`}).join('')}
function goalName(g){return{balanced:'Ăn cân bằng',weightloss:'Giảm cân',protein:'Tăng protein',fiber:'Tăng chất xơ',vegetables:'Ăn nhiều rau',lowfat:'Giảm dầu mỡ'}[g]||g}function syncOne(sel,v){$$('.option-btn',$(sel)).forEach(b=>b.classList.toggle('active',b.dataset.value===v))}function syncMulti(sel,v){$$('.option-btn',$(sel)).forEach(b=>b.classList.toggle('active',v.includes(b.dataset.value)))}function updateSteps(){$("#stepIngredients").textContent=`Đang chọn ${state.builder.selectedPantry.length} nguyên liệu`;const m={breakfast:'Bữa sáng',lunch:'Bữa trưa',dinner:'Bữa tối',snack:'Ăn nhẹ'}[state.builder.mealType];$("#stepMeal").textContent=`${m} · ${state.builder.servings} người`;$("#stepGoal").textContent=goalName(state.builder.goal)}function updateGuard(){const ms=state.members.filter(m=>m.selected),all=[...new Set([...state.builder.restrictions,...ms.flatMap(m=>m.restrictions)])];$("#healthGuardSummary").innerHTML=all.length?`<strong>Đang áp dụng:</strong> ${all.join(', ')}. Công thức có xung đột sẽ bị loại hoặc hạ điểm.`:'Không có giới hạn đặc biệt.'}
function renderBuilder(){if(!state.builder.selectedPantry.length)state.builder.selectedPantry=state.pantry.map(x=>x.id);$("#builderIngredients").innerHTML=state.pantry.map(i=>`<label class="ingredient-select"><input type="checkbox" data-pantry-select="${i.id}" ${state.builder.selectedPantry.includes(i.id)?'checked':''}><div class="food-icon">${i.emoji}</div><strong>${i.name}</strong><small>${i.qty}${i.unit}</small></label>`).join('');$("#builderFamily").innerHTML=state.members.map(m=>`<label class="member-check"><input type="checkbox" data-member-select="${m.id}" ${m.selected?'checked':''}><span class="member-avatar">${m.avatar}</span><span>${m.name}<small style="display:block;color:var(--muted);font-size:7px">${m.role}</small></span></label>`).join('');$("#servingRange").value=state.builder.servings;$("#servingValue").textContent=state.builder.servings;$("#budgetRange").value=state.builder.budget;$("#budgetValue").textContent=new Intl.NumberFormat('vi-VN').format(state.builder.budget);syncOne('#mealTypeOptions',state.builder.mealType);syncOne('#timeOptions',String(state.builder.maxTime));syncOne('#difficultyOptions',state.builder.difficulty);syncOne('#goalOptions',state.builder.goal);syncMulti('#equipmentOptions',state.builder.equipment);syncMulti('#restrictionOptions',state.builder.restrictions);updateSteps();updateGuard();lucide.createIcons()}
function mergedRestrictions(){const t=state.members.filter(m=>m.selected).flatMap(m=>m.restrictions).map(x=>x.toLowerCase()),r=[...state.builder.restrictions];if(t.some(x=>x.includes('không cay')))r.push('nospicy');if(t.some(x=>x.includes('dị ứng hạt')))r.push('nutallergy');if(t.some(x=>x.includes('hải sản')))r.push('seafoodallergy');if(t.some(x=>x.includes('không sữa')))r.push('dairyfree');if(t.some(x=>x.includes('gluten')))r.push('glutenfree');if(t.some(x=>x.includes('ăn chay')))r.push('vegetarian');return[...new Set(r)]}function roleWeight(r){return{main:5,secondary:2,seasoning:1,optional:.5}[r]||1}function goalScore(r,g){const n=r.nutrition;if(g==='weightloss')return Math.max(35,100-Math.max(0,n.calories-300)/4+n.fiber*2);if(g==='protein')return Math.min(100,35+n.protein*1.6);if(g==='fiber')return Math.min(100,35+n.fiber*6);if(g==='vegetables')return Math.min(100,40+r.ingredients.filter(x=>catalog[x.key]?.category==='vegetable').length*15);if(g==='lowfat')return Math.max(35,100-n.fat*2.5);return Math.max(45,100-(Math.abs(n.protein-30)*.8+Math.abs(n.fiber-8)*2+Math.max(0,n.calories-600)/5))}
function evaluate(r){const p=state.pantry.filter(i=>state.builder.selectedPantry.includes(i.id)),keys=new Set(p.map(x=>x.key)),res=mergedRestrictions();if(res.includes('vegetarian')&&!r.diet.includes('vegetarian'))return null;if(res.includes('dairyfree')&&r.allergens.includes('dairy'))return null;if(res.includes('glutenfree')&&r.allergens.includes('gluten'))return null;if(!r.mealTypes.includes(state.builder.mealType))return null;if(r.time>state.builder.maxTime&&state.builder.maxTime<90)return null;const order={easy:1,medium:2,hard:3};if(state.builder.difficulty!=='any'&&order[r.difficulty]>order[state.builder.difficulty])return null;if(r.equipment.some(e=>!state.builder.equipment.includes(e)))return null;let total=0,matched=0,urgent=0;const missing=[];r.ingredients.forEach(i=>{const w=roleWeight(i.role);total+=w;if(keys.has(i.key))matched+=w;else if(i.required)missing.push(i);const pi=p.find(x=>x.key===i.key);if(pi&&(daysUntil(pi.expiry)<=3||pi.condition==='cooked'))urgent++});const relevant=p.filter(x=>daysUntil(x.expiry)<=3||x.condition==='cooked').length,match=Math.round(matched/total*100),waste=relevant?Math.min(100,Math.round(urgent/relevant*100+35)):70,nutrition=Math.round(goalScore(r,'balanced')),goal=Math.round(goalScore(r,state.builder.goal)),timeScore=Math.max(40,100-Math.max(0,r.time-15)*2),cost=missing.reduce((s,i)=>s+(catalog[i.key]?.price||12000),0);let score=match*.35+waste*.2+nutrition*.15+goal*.1+timeScore*.1+100*.05+95*.05-missing.length*7-(cost>state.builder.budget?18:0);return{...r,score:Math.max(0,Math.min(99,Math.round(score))),match,waste,nutrition,goalScore:goal,timeScore,missing,missingCost:cost}}
function generate(){const a=recipes.map(evaluate).filter(Boolean).sort((x,y)=>y.score-x.score);if(!a.length){showToast('Không có công thức đáp ứng toàn bộ giới hạn. Hãy nới thời gian hoặc bộ lọc.');return}const best=a[0],fast=[...a].sort((x,y)=>x.time-y.time||y.score-x.score).find(x=>x.id!==best.id)||a[1]||best,healthy=[...a].sort((x,y)=>y.goalScore-x.goalScore).find(x=>x.id!==best.id&&x.id!==fast.id)||a.find(x=>x.id!==best.id)||best;state.results=[{...best,resultLabel:'Phù hợp nhất',badgeClass:''},{...fast,resultLabel:'Nhanh nhất',badgeClass:'fast'},{...healthy,resultLabel:'Lành mạnh nhất',badgeClass:'healthy'}];const map={};state.results.flatMap(r=>r.missing).forEach(i=>{if(!map[i.key]){const c=catalog[i.key]||{name:i.key,emoji:'🥣',category:'other',price:12000};map[i.key]={id:crypto.randomUUID(),key:i.key,name:c.name,emoji:c.emoji,qty:i.amount,unit:i.unit,category:c.category,price:c.price,done:false,essential:true}}});state.shopping=Object.values(map);save();renderResults();renderShopping();showView('recipes');showToast('Đã phân tích và tạo ba gợi ý phù hợp nhất.')}
function scoreRow(n,v){return`<div class="score-row"><span>${n}</span><div class="score-track"><span style="width:${v}%"></span></div><strong>${v}%</strong></div>`}function renderResults(){if(!state.results.length)state.results=recipes.slice(0,3).map((r,i)=>({...r,score:[92,86,88][i],match:[92,85,88][i],waste:[84,70,85][i],nutrition:[88,75,92][i],goalScore:[88,75,94][i],missing:[],missingCost:0,resultLabel:['Phù hợp nhất','Nhanh nhất','Lành mạnh nhất'][i],badgeClass:['','fast','healthy'][i]}));$("#summaryIngredients").textContent=state.builder.selectedPantry.length||state.pantry.length;$("#summaryServing").textContent=state.builder.servings;$("#summarySpend").textContent=currency(state.results.reduce((s,r)=>s+r.missingCost,0));$("#summaryWaste").textContent=Math.round(state.results.reduce((s,r)=>s+r.waste,0)/state.results.length)+'%';$("#recipeGrid").innerHTML=state.results.map(r=>`<article class="recipe-card"><div class="recipe-badge ${r.badgeClass}">${r.resultLabel}</div><img src="${r.image}" alt="${r.title}"><div class="recipe-body"><h3>${r.title}</h3><p class="recipe-desc">${r.desc}</p><div class="recipe-meta"><span><i data-lucide="clock-3"></i>${r.time} phút</span><span><i data-lucide="bar-chart-3"></i>${r.difficulty==='easy'?'Dễ':'Trung bình'}</span><span><i data-lucide="users"></i>${state.builder.servings} người</span></div><div class="recipe-score-head"><small>Điểm phù hợp tổng</small><strong>${r.score}%</strong></div><div class="score-list">${scoreRow('Nguyên liệu',r.match)}${scoreRow('Dinh dưỡng',r.nutrition)}${scoreRow('Mục tiêu',r.goalScore)}${scoreRow('Giảm lãng phí',r.waste)}</div>${r.missing.length?`<div class="missing-note">Cần mua thêm: ${r.missing.map(x=>catalog[x.key]?.name||x.key).join(', ')} · ${currency(r.missingCost)}</div>`:`<div class="missing-note" style="background:#edf8ef;color:#35704a">Có thể nấu bằng nguyên liệu đang có.</div>`}<div class="recipe-actions"><button class="primary-btn small-btn" onclick="openRecipe('${r.id}')">Xem chi tiết</button><button class="secondary-btn small-btn" onclick="showToast('Đã lưu công thức yêu thích.')"><i data-lucide="heart" width="14"></i></button></div></div></article>`).join('');lucide.createIcons()}
window.openRecipe=id=>{const r=recipes.find(x=>x.id===id),e=evaluate(r)||{...r,missing:[],missingCost:0,score:90},scale=state.builder.servings/r.servings,missing=new Set(e.missing.map(x=>x.key));$("#recipeModalBody").innerHTML=`<div class="recipe-modal-hero"><img src="${r.image}" alt="${r.title}"><div><span class="pill">${e.score||90}% phù hợp</span><h2>${r.title}</h2><p>${r.desc}</p><div class="recipe-meta" style="font-size:9px;margin-top:12px"><span><i data-lucide="clock-3"></i>${r.time} phút</span><span><i data-lucide="users"></i>${state.builder.servings} người</span><span><i data-lucide="wallet-cards"></i>Mua thêm ${currency(e.missingCost||0)}</span></div><div class="nutrition-grid"><div class="nutrition-box"><strong>${Math.round(r.nutrition.calories*scale)}</strong><small>kcal tổng</small></div><div class="nutrition-box"><strong>${Math.round(r.nutrition.protein*scale)}g</strong><small>Protein</small></div><div class="nutrition-box"><strong>${Math.round(r.nutrition.carbs*scale)}g</strong><small>Carb</small></div><div class="nutrition-box"><strong>${Math.round(r.nutrition.fat*scale)}g</strong><small>Chất béo</small></div><div class="nutrition-box"><strong>${Math.round(r.nutrition.fiber*scale)}g</strong><small>Chất xơ</small></div></div></div></div><div class="modal-detail-grid"><div class="detail-box"><h4>Nguyên liệu cho ${state.builder.servings} người</h4><ul>${r.ingredients.map(i=>`<li style="${missing.has(i.key)?'color:#d87a00;font-weight:700':''}">${catalog[i.key]?.name||i.key}: ${Math.round(i.amount*scale*10)/10}${i.unit}${missing.has(i.key)?' — cần mua':''}</li>`).join('')}</ul></div><div class="detail-box"><h4>Các bước thực hiện</h4><ol>${r.steps.map(s=>`<li>${s}</li>`).join('')}</ol></div></div><div class="health-notice" style="margin-top:15px">Dinh dưỡng được ước tính theo dữ liệu mẫu. Với dị ứng hoặc tình trạng sức khỏe cần kiểm soát nghiêm ngặt, hãy xác nhận nguyên liệu và khẩu phần với chuyên gia phù hợp.</div><div class="modal-actions"><button class="primary-btn" onclick="markCooked('${r.id}')"><i data-lucide="circle-check" width="16"></i> Đã nấu món này</button><button class="secondary-btn" onclick="addRecipeToPlan('${r.id}')"><i data-lucide="calendar-plus" width="16"></i> Thêm vào kế hoạch</button><button class="secondary-btn" onclick="addMissingToShopping('${r.id}')"><i data-lucide="shopping-basket" width="16"></i> Thêm đồ còn thiếu</button><button class="secondary-btn" onclick="shareRecipe('${r.id}')"><i data-lucide="share-2" width="16"></i> Chia sẻ</button></div>`;openModal('recipeModal');lucide.createIcons()};window.markCooked=id=>{state.history.unshift({id:crypto.randomUUID(),recipeId:id,date:todayIso(),saved:32000,rescued:.5});save();closeModal('recipeModal');renderProgress();renderHome();showToast('Đã ghi nhận món ăn và cập nhật tiến độ.')};window.addRecipeToPlan=id=>{const days=['mon','tue','wed','thu','fri','sat','sun'],k=days.map(d=>`${d}-dinner`).find(x=>!state.planner[x])||'mon-dinner';state.planner[k]=id;save();closeModal('recipeModal');renderPlanner();showToast('Đã thêm công thức vào kế hoạch tuần.')};window.addMissingToShopping=id=>{const e=evaluate(recipes.find(r=>r.id===id));if(!e)return;e.missing.forEach(i=>{if(!state.shopping.some(x=>x.key===i.key)){const c=catalog[i.key]||{name:i.key,emoji:'🥣',category:'other',price:12000};state.shopping.push({id:crypto.randomUUID(),key:i.key,name:c.name,emoji:c.emoji,qty:i.amount,unit:i.unit,category:c.category,price:c.price,done:false,essential:true})}});save();renderShopping();showToast('Đã thêm nguyên liệu còn thiếu vào danh sách mua.')};window.shareRecipe=async id=>{const r=recipes.find(x=>x.id===id),text=`${r.title} — công thức gợi ý từ ReMeal, ${r.time} phút.`;if(navigator.share)try{await navigator.share({title:r.title,text})}catch(e){}else{await navigator.clipboard.writeText(text);showToast('Đã sao chép nội dung chia sẻ.')}};
const dayLabels=[['mon','Thứ 2'],['tue','Thứ 3'],['wed','Thứ 4'],['thu','Thứ 5'],['fri','Thứ 6'],['sat','Thứ 7'],['sun','CN']],mealLabels=[['breakfast','Sáng'],['lunch','Trưa'],['dinner','Tối'],['snack','Ăn nhẹ']];function renderPlanner(){let h=`<div></div>${dayLabels.map(x=>`<div class="head">${x[1]}</div>`).join('')}`;mealLabels.forEach(([m,l])=>{h+=`<div class="meal-label">${l}</div>`;dayLabels.forEach(([d])=>{const k=`${d}-${m}`,r=recipes.find(x=>x.id===state.planner[k]);h+=r?`<div class="plan-cell"><button class="plan-remove" onclick="removePlan('${k}')">×</button><div class="plan-meal"><img src="${r.image}" alt="${r.title}"><div><strong>${r.title}</strong><small>${r.time} phút</small></div></div></div>`:`<button class="plan-cell empty" onclick="quickAddPlan('${k}')">+</button>`})});$("#plannerTable").innerHTML=h;const ps=Object.values(state.planner).map(id=>recipes.find(r=>r.id===id)).filter(Boolean);$("#planMealsCount").textContent=ps.length;$("#planSpend").textContent=currency(state.shopping.reduce((s,x)=>s+(x.done?0:x.price),0));$("#planProtein").textContent=ps.length?Math.round(ps.reduce((s,r)=>s+r.nutrition.protein,0)/7)+'g':'0g';$("#planWaste").textContent=ps.length?Math.min(40,15+ps.length*2)+'%':'0%';lucide.createIcons()}window.removePlan=k=>{delete state.planner[k];save();renderPlanner()};window.quickAddPlan=k=>{const m=k.split('-')[1],r=recipes.find(x=>x.mealTypes.includes(m))||recipes[0];state.planner[k]=r.id;save();renderPlanner()};function autoPlan(){let idx=0;mealLabels.forEach(([m])=>dayLabels.forEach(([d])=>{const o=recipes.filter(r=>r.mealTypes.includes(m));if(o.length)state.planner[`${d}-${m}`]=o[idx++%o.length].id}));buildShoppingFromPlan();save();renderPlanner();renderShopping();showToast('Đã tạo kế hoạch bữa ăn 7 ngày.')}function buildShoppingFromPlan(){const pk=new Set(state.pantry.map(x=>x.key)),map={};Object.values(state.planner).forEach(id=>{const r=recipes.find(x=>x.id===id);if(!r)return;r.ingredients.filter(i=>i.required&&!pk.has(i.key)).forEach(i=>{if(!map[i.key]){const c=catalog[i.key]||{name:i.key,emoji:'🥣',category:'other',price:12000};map[i.key]={id:crypto.randomUUID(),key:i.key,name:c.name,emoji:c.emoji,qty:i.amount,unit:i.unit,category:c.category,price:c.price,done:false,essential:true}}else map[i.key].qty+=i.amount})});state.shopping=Object.values(map)}
function renderShopping(){const g={};state.shopping.forEach(i=>(g[i.category||'other']||(g[i.category||'other']=[])).push(i));const labels={protein:'Chất đạm',vegetable:'Rau củ',grain:'Tinh bột',other:'Khác'};$("#shoppingList").innerHTML=Object.keys(g).length?Object.entries(g).map(([c,items])=>`<div class="category-label">${labels[c]||c}</div><div class="shopping-list">${items.map(i=>`<div class="shopping-item ${i.done?'done':''}"><input type="checkbox" ${i.done?'checked':''} onchange="toggleShopping('${i.id}')"><div class="food-icon">${i.emoji}</div><div><strong>${i.name}</strong><small>${Math.round(i.qty*10)/10}${i.unit} · ${i.essential?'Thiết yếu':'Tùy chọn'}</small></div><span class="shopping-price">${currency(i.price)}</span></div>`).join('')}</div>`).join(''):`<div class="health-notice">Danh sách mua đang trống. Hãy tạo gợi ý hoặc kế hoạch tuần.</div>`;const t=state.shopping.filter(x=>!x.done).reduce((s,x)=>s+x.price,0),e=state.shopping.filter(x=>!x.done&&x.essential).reduce((s,x)=>s+x.price,0),o=state.shopping.filter(x=>!x.done&&!x.essential).reduce((s,x)=>s+x.price,0);$("#shoppingTotal").textContent=currency(t);$("#shoppingEssential").textContent=currency(e);$("#shoppingOptional").textContent=currency(o);$("#shoppingDone").textContent=state.shopping.filter(x=>x.done).length+' mục'}window.toggleShopping=id=>{const i=state.shopping.find(x=>x.id===id);if(i)i.done=!i.done;save();renderShopping()};function addCustomShopping(){const name=prompt('Tên nguyên liệu cần mua:');if(!name)return;const price=+(prompt('Giá dự kiến:','10000')||10000);state.shopping.push({id:crypto.randomUUID(),key:name.toLowerCase(),name,emoji:'🛒',qty:1,unit:'phần',category:'other',price,done:false,essential:false});save();renderShopping()}function moveBought(){const b=state.shopping.filter(x=>x.done);b.forEach(i=>state.pantry.push({id:crypto.randomUUID(),key:i.key,name:i.name,emoji:i.emoji,qty:i.qty,unit:i.unit,expiry:addDays(7),condition:'fresh',category:i.category}));state.shopping=state.shopping.filter(x=>!x.done);save();renderShopping();renderPantry();renderBuilder();showToast(`Đã chuyển ${b.length} mục vào tủ lạnh.`)}async function shareShopping(){const text=state.shopping.filter(x=>!x.done).map(x=>`• ${x.name}: ${x.qty}${x.unit}`).join('\n')||'Danh sách mua đang trống.';if(navigator.share)try{await navigator.share({title:'Danh sách mua ReMeal',text})}catch(e){}else{await navigator.clipboard.writeText(text);showToast('Đã sao chép danh sách mua.')}}
function renderFamily(){$("#familyGrid").innerHTML=state.members.map(m=>`<article class="family-card"><div class="family-card-top"><div class="member-avatar">${m.avatar}</div><div><h4>${m.name}</h4><p>${m.role}</p></div></div><div class="tag-wrap"><span class="mini-tag">${goalName(m.goal)}</span>${m.restrictions.map(r=>`<span class="mini-tag warn">${r}</span>`).join('')}</div><p style="margin-top:10px;line-height:1.55">${m.note||'Chưa có ghi chú khẩu vị.'}</p><div class="family-card-actions"><button class="small-btn ${m.selected?'soft-btn':'secondary-btn'}" onclick="toggleMember('${m.id}')">${m.selected?'Đang chọn':'Chọn cho bữa ăn'}</button><button class="small-btn danger-btn" onclick="removeMember('${m.id}')">Xóa</button></div></article>`).join('');const s=state.members.filter(m=>m.selected),r=[...new Set(s.flatMap(m=>m.restrictions))];$("#householdFit").innerHTML=s.length?`<strong>${s.map(m=>m.name).join(', ')}</strong><br>Yêu cầu chung: ${r.length?r.join(', '):'Không có giới hạn bắt buộc'}. Hệ thống sẽ ưu tiên mục tiêu ${[...new Set(s.map(m=>goalName(m.goal)))].join(' và ').toLowerCase()}.`:'Chưa chọn thành viên nào cho bữa ăn.';renderBuilder()}window.toggleMember=id=>{const m=state.members.find(x=>x.id===id);if(m)m.selected=!m.selected;save();renderFamily();updateGuard()};window.removeMember=id=>{state.members=state.members.filter(x=>x.id!==id);save();renderFamily()};function renderProgress(){const meals=9+state.history.length,money=82000+state.history.reduce((s,h)=>s+h.saved,0),food=6.8+state.history.reduce((s,h)=>s+h.rescued,0);$("#progressMeals").textContent=meals;$("#progressMoney").textContent=currency(money);$("#progressFood").textContent=food.toFixed(1).replace('.',',')+'kg';$("#progressStreak").textContent=Math.min(14,3+state.history.length)+' ngày';$("#historyList").innerHTML=state.history.slice(0,6).map(h=>{const r=recipes.find(x=>x.id===h.recipeId);return r?`<div class="history-item"><img src="${r.image}" alt="${r.title}"><div><strong>${r.title}</strong><small>${h.date} · Giải cứu ${h.rescued}kg</small></div><span>+${currency(h.saved)}</span></div>`:''}).join('')||`<div class="health-notice">Chưa có lịch sử nấu ăn.</div>`;renderHome()}
function openModal(id){$("#"+id).classList.add('show');document.body.style.overflow='hidden'}function closeModal(id){$("#"+id).classList.remove('show');document.body.style.overflow=''}window.closeModal=closeModal;$$('.nav-btn,[data-view]').forEach(b=>b.addEventListener('click',e=>{if(b.dataset.view){e.preventDefault();showView(b.dataset.view)}}));$("#menuBtn").onclick=()=>$("#mainNav").classList.toggle('show');$$('[data-close]').forEach(b=>b.onclick=()=>closeModal(b.dataset.close));$$('.modal').forEach(m=>m.onclick=e=>{if(e.target===m)closeModal(m.id)});$("#openPantryModal").onclick=()=>{$("#pantryForm [name=expiry]").value=addDays(7);openModal('pantryModal')};$("#pantryForm").onsubmit=e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target)),key=d.name.toLowerCase().replace(/\s+/g,'-');state.pantry.push({id:crypto.randomUUID(),key,name:d.name,emoji:d.emoji||'🥣',qty:+d.qty,unit:d.unit,expiry:d.expiry,condition:d.condition,category:d.category});save();closeModal('pantryModal');e.target.reset();renderPantry();renderBuilder();showToast('Đã thêm nguyên liệu vào tủ lạnh.')};$("#openFamilyModal").onclick=()=>openModal('familyModal');$("#familyForm").onsubmit=e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));state.members.push({id:crypto.randomUUID(),name:d.name,role:d.role||'Thành viên',avatar:d.avatar||'🙂',goal:d.goal,restrictions:d.restrictions.split(',').map(x=>x.trim()).filter(Boolean),note:d.note,selected:false});save();closeModal('familyModal');e.target.reset();renderFamily();showToast('Đã thêm thành viên gia đình.')};$("#pantrySearch").oninput=renderPantry;$("#pantryFilter").onchange=renderPantry;$("#pantryCategory").onchange=renderPantry;$("#leftoverSelect").onchange=renderLeftovers;$("#selectAllPantry").onclick=()=>{state.builder.selectedPantry=state.builder.selectedPantry.length===state.pantry.length?[]:state.pantry.map(x=>x.id);renderBuilder()};$("#builderIngredients").onchange=e=>{const id=e.target.dataset.pantrySelect;if(!id)return;if(e.target.checked)state.builder.selectedPantry.push(id);else state.builder.selectedPantry=state.builder.selectedPantry.filter(x=>x!==id);state.builder.selectedPantry=[...new Set(state.builder.selectedPantry)];updateSteps()};$("#builderFamily").onchange=e=>{const m=state.members.find(x=>x.id===e.target.dataset.memberSelect);if(m)m.selected=e.target.checked;save();updateGuard()};function bindOne(sel,key,tr=v=>v){$(sel).onclick=e=>{const b=e.target.closest('.option-btn');if(!b)return;$$('.option-btn',$(sel)).forEach(x=>x.classList.remove('active'));b.classList.add('active');state.builder[key]=tr(b.dataset.value);updateSteps()}}function bindMulti(sel,key){$(sel).onclick=e=>{const b=e.target.closest('.option-btn');if(!b)return;b.classList.toggle('active');const v=b.dataset.value,a=state.builder[key];if(b.classList.contains('active'))a.push(v);else state.builder[key]=a.filter(x=>x!==v);state.builder[key]=[...new Set(state.builder[key])];updateGuard()}}bindOne('#mealTypeOptions','mealType');bindOne('#timeOptions','maxTime',Number);bindOne('#difficultyOptions','difficulty');bindOne('#goalOptions','goal');bindMulti('#equipmentOptions','equipment');bindMulti('#restrictionOptions','restrictions');$("#servingRange").oninput=e=>{state.builder.servings=+e.target.value;$("#servingValue").textContent=state.builder.servings;updateSteps()};$("#budgetRange").oninput=e=>{state.builder.budget=+e.target.value;$("#budgetValue").textContent=new Intl.NumberFormat('vi-VN').format(state.builder.budget)};$("#generateRecipesBtn").onclick=generate;$("#resetBuilderBtn").onclick=()=>{state.builder={selectedPantry:state.pantry.map(x=>x.id),mealType:'dinner',servings:2,maxTime:30,difficulty:'easy',equipment:['stove','pan','pot'],budget:50000,goal:'balanced',restrictions:['nospicy']};state.members.forEach((m,i)=>m.selected=i<2);renderBuilder();showToast('Đã đặt lại lựa chọn.')};$("#autoPlanBtn").onclick=autoPlan;$("#clearPlanBtn").onclick=()=>{state.planner={};save();renderPlanner();showToast('Đã xóa kế hoạch tuần.')};$("#addCustomShoppingBtn").onclick=addCustomShopping;$("#moveBoughtToPantry").onclick=moveBought;$("#shareShoppingBtn").onclick=shareShopping;$("#exportJsonBtn").onclick=()=>{const blob=new Blob([JSON.stringify({pantry:state.pantry,members:state.members,planner:state.planner,shopping:state.shopping},null,2)],{type:'application/json'}),u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download='remeal-data.json';a.click();URL.revokeObjectURL(u);showToast('Đã xuất dữ liệu JSON.')};$("#resetDemoData").onclick=()=>{if(!confirm('Khôi phục toàn bộ dữ liệu demo?'))return;['remeal_pantry','remeal_members','remeal_planner','remeal_shopping','remeal_history'].forEach(k=>localStorage.removeItem(k));location.reload()};renderHome();renderPantry();renderLeftovers();renderBuilder();renderResults();renderPlanner();renderShopping();renderFamily();renderProgress();lucide.createIcons();



