            <div class="usage-grid" id="usageGrid"></div>
          </section>
          <section class="panel account-panel">
            <div class="panel-title"><div><h3>Quyền lợi đang mở khóa</h3><small>Các mục bị khóa sẽ được mở sau khi nâng cấp đúng gói.</small></div></div>
            <div class="subscription-feature-grid" id="subscriptionFeatureGrid"></div>
          </section>
          <section class="panel account-panel">
            <div class="panel-title"><div><h3>Loại tài khoản</h3><small>Loại tài khoản quyết định cách tổ chức dữ liệu, không nhất thiết quyết định giá.</small></div></div>
            <div class="account-type-grid" id="accountTypeManager"></div>
          </section>
          <section class="panel account-panel">
            <div class="panel-title"><div><h3>Lịch sử thanh toán</h3><small>Dữ liệu minh họa trong prototype.</small></div></div>
            <div class="billing-history" id="billingHistory"></div>
          </section>
        </div>
      </div>
