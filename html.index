  healthPro:{id:'healthPro',name:'Health & Fitness Pro',audiences:['personal'],monthly:149000,yearly:119000,icon:'activity',tagline:'Cho người giảm cân, tăng cơ hoặc theo dõi macro.',description:'Tập trung vào mục tiêu calorie, macro, tập luyện và tiến độ cơ thể.',features:['Toàn bộ quyền lợi Personal Plus','Mục tiêu calorie và macro hằng ngày','Bữa ăn trước và sau tập','Theo dõi cân nặng và số đo','Biểu đồ tiến độ chuyên sâu','Xuất dữ liệu cho huấn luyện viên'],missing:[]},
  proStarter:{id:'proStarter',name:'Professional Starter',audiences:['professional'],monthly:399000,yearly:329000,icon:'briefcase-medical',recommended:true,tagline:'Dành cho chuyên gia bắt đầu quản lý khách hàng.',description:'Bộ công cụ lập thực đơn, theo dõi và xuất báo cáo chuyên nghiệp.',features:['Quản lý tối đa 10 khách hàng','Template thực đơn và nhân bản kế hoạch','Theo dõi mức độ hoàn thành','Ghi chú và phản hồi khách hàng','Xuất báo cáo có thương hiệu'],missing:[]},
  proGrowth:{id:'proGrowth',name:'Professional Growth',audiences:['professional'],monthly:799000,yearly:659000,icon:'chart-no-axes-combined',tagline:'Cho chuyên gia hoặc studio đang mở rộng.',description:'Tăng số khách hàng, phân quyền trợ lý và báo cáo nâng cao.',features:['Quản lý tối đa 50 khách hàng','Tất cả quyền lợi Starter','Phân quyền trợ lý','Dashboard hiệu suất khách hàng','Thư viện công thức riêng'],missing:[]},
  business:{id:'business',name:'Business',audiences:['business'],monthly:null,yearly:null,icon:'building-2',tagline:'Giải pháp cho bếp ăn, trường học, văn phòng và đối tác.',description:'Quản lý kho, thực đơn số lượng lớn, nhiều địa điểm và kết nối hệ thống.',features:['Tính nguyên liệu cho hàng trăm khẩu phần','Quản lý nhiều kho và chi nhánh','Báo cáo tồn kho, hao hụt và dự báo','Phân quyền nhân viên và quy trình duyệt','API và hỗ trợ triển khai riêng'],missing:[]}
};
const PLAN_FEATURES = {
  free:['coreRecipes','basicPantry','basicFilters'],
  personalPlus:['coreRecipes','basicPantry','basicFilters','unlimitedPantry','weeklyPlan','detailedNutrition','smartShopping','expiryAlerts','substitutions','reports','scanPantry'],
  familyPremium:['coreRecipes','basicPantry','basicFilters','unlimitedPantry','weeklyPlan','detailedNutrition','smartShopping','expiryAlerts','substitutions','reports','scanPantry','familyProfiles','sharedPantry','familySync','guestMode','householdOptimization'],
  healthPro:['coreRecipes','basicPantry','basicFilters','unlimitedPantry','weeklyPlan','detailedNutrition','smartShopping','expiryAlerts','substitutions','reports','scanPantry','macros','fitnessMeals','weightTracking','advancedCharts'],
  proStarter:['coreRecipes','basicPantry','basicFilters','unlimitedPantry','weeklyPlan','detailedNutrition','smartShopping','expiryAlerts','substitutions','reports','scanPantry','macros','advancedCharts','clientDashboard','templates','clientReports','whiteLabel'],
  proGrowth:['coreRecipes','basicPantry','basicFilters','unlimitedPantry','weeklyPlan','detailedNutrition','smartShopping','expiryAlerts','substitutions','reports','scanPantry','macros','advancedCharts','clientDashboard','templates','clientReports','whiteLabel','assistantRoles','clientAnalytics'],
  business:['coreRecipes','basicPantry','basicFilters','unlimitedPantry','weeklyPlan','detailedNutrition','smartShopping','expiryAlerts','substitutions','reports','scanPantry','familyProfiles','sharedPantry','macros','advancedCharts','clientDashboard','templates','multiLocation','bulkPortions','inventoryForecast','roles','api']
};
const FEATURE_INFO = {
  weeklyPlan:{title:'Kế hoạch bữa ăn tuần tự động',description:'Tạo kế hoạch 7–14 ngày, ưu tiên nguyên liệu sắp hết hạn và tự động tổng hợp danh sách mua.',recommended:'personalPlus',benefits:['Lên lịch 7–14 ngày','Ưu tiên đồ nhanh hỏng','Tạo danh sách mua tự động']},
  familyProfiles:{title:'Hồ sơ nhiều thành viên',description:'Thêm hồ sơ, dị ứng, khẩu phần và sở thích riêng cho từng người trong gia đình.',recommended:'familyPremium',benefits:['Tối đa 8 thành viên','Dị ứng riêng từng người','Tối ưu món chung']},
  smartShopping:{title:'Danh sách mua sắm thông minh',description:'Tự động gộp nguyên liệu còn thiếu, dự toán ngân sách và đồng bộ với kế hoạch.',recommended:'personalPlus',benefits:['Gộp đồ còn thiếu','Ước tính chi phí','Chuyển nhanh vào tủ']},
  reports:{title:'Báo cáo và xuất dữ liệu',description:'Theo dõi tiền tiết kiệm, thực phẩm được giải cứu và xuất dữ liệu để lưu hoặc chia sẻ.',recommended:'personalPlus',benefits:['Báo cáo tiến độ','Xuất dữ liệu','Theo dõi tiết kiệm']},
  macros:{title:'Theo dõi calorie và macro',description:'Thiết lập mục tiêu protein, carbohydrate, chất béo và calorie theo ngày.',recommended:'healthPro',benefits:['Mục tiêu hằng ngày','Biểu đồ chuyên sâu','Bữa trước và sau tập']}
};
const ACCOUNT_TYPE_INFO = {
  personal:{name:'Tài khoản cá nhân',icon:'👤',description:'Quản lý bữa ăn và mục tiêu của riêng bạn.'},
  family:{name:'Tài khoản gia đình',icon:'👨‍👩‍👧',description:'Nhiều thành viên dùng chung dữ liệu bữa ăn.'},
  professional:{name:'Tài khoản chuyên gia',icon:'🧑‍⚕️',description:'Quản lý khách hàng và kế hoạch dinh dưỡng.'},
  business:{name:'Tài khoản doanh nghiệp',icon:'🏢',description:'Quản lý bếp ăn, kho và nhiều địa điểm.'}
};
let subscriptionState = JSON.parse(localStorage.getItem('remeal_subscription') || 'null') || {plan:'free',accountType:'personal',billing:'monthly',startedAt:todayIso()};
let pricingAudience = subscriptionState.accountType;
let checkoutPlanId = null;
function saveSubscription(){localStorage.setItem('remeal_subscription',JSON.stringify(subscriptionState))}
function hasFeature(feature){return (PLAN_FEATURES[subscriptionState.plan]||[]).includes(feature)}
function planPrice(plan){if(plan.monthly===null)return 'Liên hệ';const value=subscriptionState.billing==='yearly'?plan.yearly:plan.monthly;return currency(value)}
function planBillingSuffix(plan){if(plan.monthly===null)return '';return subscriptionState.billing==='yearly'?'/tháng · thanh toán năm':'/tháng'}
function audienceName(type){return ACCOUNT_TYPE_INFO[type]?.name || type}
function updateSubscriptionUI(){
  const plan=PLAN_DEFINITIONS[subscriptionState.plan]||PLAN_DEFINITIONS.free;
  $('#currentPlanChipText').textContent=plan.name;
  $('#headerAccountType').textContent=audienceName(subscriptionState.accountType);
  $('#currentPlanChip').classList.toggle('current-plan-chip',subscriptionState.plan!=='free');
  const title=$('#homeUpgradeTitle'),copy=$('#homeUpgradeText'),strip=$('#homeUpgradeStrip');
  if(subscriptionState.plan==='free'){
    title.textContent='Mở khóa kế hoạch tuần và công cụ thông minh';
    copy.textContent='Nâng cấp để nhận kế hoạch 7–14 ngày, danh sách mua tự động, nhiều hồ sơ và báo cáo chi tiết.';
    strip.style.display='grid';
  }else{
    title.textContent=`Bạn đang dùng ${plan.name}`;
    copy.textContent='Các quyền lợi trả phí đã được mở khóa. Bạn có thể quản lý gói và loại tài khoản trong Trung tâm tài khoản.';
    strip.style.display='grid';
  }
  applyFeatureLocks();renderAccount();renderPlans();lucide.createIcons();
}
function renderPlans(){
  $$('.account-type-card',$('#pricingAccountTypes')).forEach(card=>card.classList.toggle('active',card.dataset.audience===pricingAudience));
  $$('.billing-btn').forEach(btn=>btn.classList.toggle('active',btn.dataset.billing===subscriptionState.billing));
  const hints={personal:'Dành cho cá nhân: Free, Personal Plus và Health Pro',family:'Dành cho gia đình: Free và Family Premium',professional:'Dành cho chuyên gia dinh dưỡng và huấn luyện viên',business:'Dành cho bếp ăn, doanh nghiệp và đối tác'};
  $('#audienceHint').textContent=hints[pricingAudience];
  const plans=Object.values(PLAN_DEFINITIONS).filter(plan=>plan.audiences.includes(pricingAudience));
  $('#pricingGrid').innerHTML=plans.map(plan=>{
    const current=subscriptionState.plan===plan.id;
    const typeClass=plan.id==='healthPro'?'health':plan.id.startsWith('pro')?'pro':plan.id==='business'?'business':'';
    const yearlySaving=plan.monthly&&plan.yearly?`Tiết kiệm ${currency((plan.monthly-plan.yearly)*12)} mỗi năm`:'';
    return `<article class="panel pricing-card ${plan.recommended?'recommended':''} ${typeClass}">
      ${plan.recommended?'<div class="recommended-ribbon">ĐỀ XUẤT</div>':''}
      <div class="pricing-top"><div class="plan-icon"><i data-lucide="${plan.icon}"></i></div><h3>${plan.name}</h3><p class="plan-subtitle">${plan.tagline}</p><div class="plan-price"><strong>${planPrice(plan)}</strong><span>${planBillingSuffix(plan)}</span></div><div class="plan-year-note">${yearlySaving||'Không yêu cầu thẻ để dùng gói Free'}</div></div>
      <div class="plan-features">${plan.features.map(f=>`<div class="plan-feature"><i data-lucide="circle-check"></i><span>${f}</span></div>`).join('')}${plan.missing.map(f=>`<div class="plan-feature muted"><i data-lucide="minus-circle"></i><span>${f}</span></div>`).join('')}</div>
      <button class="${current?'current-plan-btn':'primary-btn'} plan-cta" ${current?'disabled':''} onclick="${current?'void(0)':`openCheckout('${plan.id}')`}">${current?'Gói hiện tại':plan.id==='business'?'Liên hệ tư vấn':'Chọn gói này'}</button>
    </article>`;
  }).join('') + (pricingAudience==='professional'?'<div class="plan-audience-note">Professional Clinic dành cho phòng khám hoặc đội ngũ nhiều chuyên gia sẽ được báo giá riêng, có phân quyền nâng cao và triển khai theo thương hiệu.</div>':'');
  lucide.createIcons();
}
function renderAccount(){
  if(!$('#accountPlanName'))return;
  const plan=PLAN_DEFINITIONS[subscriptionState.plan]||PLAN_DEFINITIONS.free;
  $('#accountTypeBadge').textContent=audienceName(subscriptionState.accountType);
  $('#accountPlanName').textContent=plan.name;
  $('#accountPlanDescription').textContent=plan.description;
  $('#accountPlanPrice').textContent=plan.monthly===null?'Liên hệ':planPrice(plan);
  $('#accountBillingNote').textContent=plan.monthly===null?' để nhận báo giá':` ${planBillingSuffix(plan)}`;
  $('#usagePlanPill').textContent=plan.name;
  $('#accountUpgradeBtn').textContent=subscriptionState.plan==='free'?'Nâng cấp gói':'Đổi hoặc quản lý gói';
  const limits=subscriptionState.plan==='free'?[['Nguyên liệu trong tủ',state.pantry.length,20],['Gợi ý hôm nay',2,3],['Hồ sơ thành viên',1,1],['Ngày kế hoạch',3,3]]:[['Nguyên liệu trong tủ',state.pantry.length,'∞'],['Gợi ý hôm nay',7,'∞'],['Hồ sơ thành viên',state.members.length,subscriptionState.plan==='familyPremium'?8:'∞'],['Ngày kế hoạch',14,14]];
  $('#usageGrid').innerHTML=limits.map(([label,current,max])=>{const pct=max==='∞'?Math.min(70,current*6):Math.min(100,current/max*100);return `<div class="usage-card"><div class="usage-card-head"><strong>${label}</strong><span>${current}/${max}</span></div><div class="usage-track"><span style="width:${pct}%"></span></div></div>`}).join('');
  const featureList=[['weeklyPlan','Kế hoạch tuần tự động','Lên lịch 7–14 ngày'],['smartShopping','Danh sách mua thông minh','Gộp đồ còn thiếu'],['familyProfiles','Hồ sơ gia đình','Nhiều thành viên'],['macros','Theo dõi macro','Calorie và dinh dưỡng'],['reports','Báo cáo tiến độ','Tiết kiệm và lãng phí'],['scanPantry','Quét tủ lạnh','Ảnh, hóa đơn, mã vạch']];
  $('#subscriptionFeatureGrid').innerHTML=featureList.map(([key,title,desc])=>`<div class="sub-feature ${hasFeature(key)?'':'locked'}"><i data-lucide="${hasFeature(key)?'circle-check':'lock-keyhole'}"></i><div><strong>${title}</strong><small>${hasFeature(key)?desc:'Cần nâng cấp gói phù hợp'}</small></div></div>`).join('');
  $('#accountTypeManager').innerHTML=Object.entries(ACCOUNT_TYPE_INFO).map(([key,item])=>`<button class="account-type-card ${subscriptionState.accountType===key?'active':''}" onclick="changeAccountType('${key}')"><span class="type-check"><i data-lucide="check"></i></span><div class="type-icon">${item.icon}</div><h3>${item.name.replace('Tài khoản ','')}</h3><p>${item.description}</p></button>`).join('');
  const payments=subscriptionState.plan==='free'?[['Chưa có giao dịch','Gói Free','0đ']]:[[subscriptionState.startedAt,plan.name,planPrice(plan)],['01/07/2026','Hóa đơn minh họa',planPrice(plan)]];
  $('#billingHistory').innerHTML=payments.map(row=>`<div class="billing-item"><strong>${row[0]}</strong><span>${row[1]}</span><strong>${row[2]}</strong></div>`).join('');
  lucide.createIcons();
}
window.changeAccountType=function(type){
  if(subscriptionState.accountType===type)return;
  if(!confirm(`Chuyển sang ${audienceName(type)}? Dữ liệu hiện tại vẫn được giữ trong prototype.`))return;
  subscriptionState.accountType=type;pricingAudience=type;saveSubscription();updateSubscriptionUI();showToast(`Đã chuyển sang ${audienceName(type)}.`)
};
window.openCheckout=function(planId){
  const plan=PLAN_DEFINITIONS[planId];if(!plan)return;
  checkoutPlanId=planId;
  if(planId==='business'){
    $('#checkoutSummary').innerHTML=`<span class="pill orange">Giải pháp doanh nghiệp</span><h2>${plan.name}</h2><p>${plan.description}</p><div class="checkout-price">Liên hệ</div><div class="checkout-features">${plan.features.map(f=>`<div class="checkout-feature"><i data-lucide="circle-check"></i>${f}</div>`).join('')}</div>`;
    $('#checkoutConfirmBtn').textContent='Gửi yêu cầu tư vấn';
  }else{
    $('#checkoutSummary').innerHTML=`<span class="pill">${audienceName(plan.audiences[0])}</span><h2>${plan.name}</h2><p>${plan.description}</p><div class="checkout-price">${planPrice(plan)} <span style="font-size:10px;font-weight:500;color:var(--muted)">${planBillingSuffix(plan)}</span></div><div class="checkout-features">${plan.features.slice(0,6).map(f=>`<div class="checkout-feature"><i data-lucide="circle-check"></i>${f}</div>`).join('')}</div>`;
    $('#checkoutConfirmBtn').textContent=planId==='free'?'Chuyển về gói Free':'Xác nhận nâng cấp';
  }
  openModal('checkoutModal');lucide.createIcons();
};
function showUpgradeLock(feature){
  const info=FEATURE_INFO[feature]||FEATURE_INFO.weeklyPlan;
  $('#lockedFeatureTitle').textContent=info.title;
  $('#lockedFeatureDescription').textContent=info.description;
  $('#lockedFeatureBenefits').innerHTML=info.benefits.map(b=>`<div class="upgrade-lock-benefit"><strong>✓ ${b}</strong>Được mở ngay sau khi nâng cấp.</div>`).join('');
  $('#lockedFeatureUpgradeBtn').onclick=()=>{closeModal('upgradeLockModal');pricingAudience=PLAN_DEFINITIONS[info.recommended].audiences[0];showView('plans');renderPlans()};
  openModal('upgradeLockModal');lucide.createIcons();
}
function applyFeatureLocks(){
  const gated=[['#autoPlanBtn','weeklyPlan'],['#exportJsonBtn','reports'],['#shareShoppingBtn','smartShopping'],['#openFamilyModal','familyProfiles'],['#moveBoughtToPantry','smartShopping']];
  gated.forEach(([selector,feature])=>{const el=$(selector);if(!el)return;el.dataset.premiumFeature=feature;el.classList.toggle('premium-locked',!hasFeature(feature));});
}
document.addEventListener('click',event=>{
  const gated=event.target.closest('[data-premium-feature]');
  if(gated&&!hasFeature(gated.dataset.premiumFeature)){event.preventDefault();event.stopImmediatePropagation();showUpgradeLock(gated.dataset.premiumFeature)}
},true);
$('#pricingAccountTypes').addEventListener('click',event=>{const card=event.target.closest('[data-audience]');if(!card)return;pricingAudience=card.dataset.audience;renderPlans()});
$$('.billing-btn').forEach(btn=>btn.addEventListener('click',()=>{subscriptionState.billing=btn.dataset.billing;saveSubscription();renderPlans();renderAccount()}));
$('#changeAccountTypeBtn').addEventListener('click',()=>{showView('plans');window.scrollTo({top:250,behavior:'smooth'})});
$('#checkoutForm').addEventListener('submit',event=>{
  event.preventDefault();const plan=PLAN_DEFINITIONS[checkoutPlanId];if(!plan)return;
  subscriptionState.plan=checkoutPlanId;
  if(plan.audiences.length===1)subscriptionState.accountType=plan.audiences[0];
  subscriptionState.startedAt=todayIso();pricingAudience=subscriptionState.accountType;saveSubscription();closeModal('checkoutModal');updateSubscriptionUI();showView('account');showToast(checkoutPlanId==='business'?'Đã ghi nhận yêu cầu tư vấn.':'Đã cập nhật gói '+plan.name+'.');
});
$('#paymentMethods').addEventListener('click',event=>{const btn=event.target.closest('.payment-method');if(!btn)return;$$('.payment-method',$('#paymentMethods')).forEach(x=>x.classList.remove('active'));btn.classList.add('active')});
// Free-plan pantry limit
$('#pantryForm').addEventListener('submit',event=>{if(subscriptionState.plan==='free'&&state.pantry.length>=20){event.preventDefault();event.stopImmediatePropagation();closeModal('pantryModal');showUpgradeLock('reports')}},true);
updateSubscriptionUI();


// --- Music Widget: playlist YouTube theo thể loại (Việt/Hàn/Trung/Lofi) ---
(function(){
  const PLAYLISTS = {
    vpop: 'PLVFZDXxa2oOPVdSzS9_Ow_PNU8llWMsLa',
    kpop: 'PLOHoVaTp8R7ccrQM3EpCTVDdwHhXrJhXS',
    cpop: 'PLYsAoprptZOo_L1Je3wXa02rbF0jqz2E5',
    lofi: 'PLvGUEIPxRGvWvkelmgyWU6QET6mmGbd8W'
  };
  const fab = document.getElementById('musicFabBtn');
  const panel = document.getElementById('musicPanel');
  const closeBtn = document.getElementById('musicCloseBtn');
  const frame = document.getElementById('musicFrame');
  const tabs = document.querySelectorAll('.music-tab');
  let currentGenre = 'vpop';

  function loadGenre(genre){
    currentGenre = genre;
    frame.src = `https://www.youtube.com/embed/videoseries?list=${PLAYLISTS[genre]}&autoplay=0&rel=0`;
    tabs.forEach(t => t.classList.toggle('active', t.dataset.genre === genre));
  }

  fab.addEventListener('click', () => {
    panel.classList.add('show');
    if (!frame.src) loadGenre(currentGenre);
  });
  closeBtn.addEventListener('click', () => panel.classList.remove('show'));
  tabs.forEach(t => t.addEventListener('click', () => loadGenre(t.dataset.genre)));
})();
</script>
</body>
</html>
